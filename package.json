{
  "name": "poordown",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gioco da tavolo multiplayer da giocare con gli amici in rete locale.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @poordown/server",
    "build": "npm run build -w @poordown/web",
    "prestart": "npm run build",
    "start": "npm run start -w @poordown/server",
    "preonline": "npm run build",
    "online": "npm run online -w @poordown/server",
    "pannello": "npm run pannello --silent -w @poordown/server --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
