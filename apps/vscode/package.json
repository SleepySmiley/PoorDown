{
  "name": "poordown",
  "displayName": "PoorDown",
  "description": "Gioco da tavolo multiplayer da giocare con gli amici: accendi la partita e gioca dentro VS Code.",
  "version": "0.1.1",
  "publisher": "PoorDown",
  "license": "MIT",
  "private": true,
  "pricing": "Free",
  "icon": "media/icona.png",
  "galleryBanner": {
    "color": "#2a64c8",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SleepySmiley/PoorDown.git",
    "directory": "apps/vscode"
  },
  "bugs": {
    "url": "https://github.com/SleepySmiley/PoorDown/issues"
  },
  "homepage": "https://github.com/SleepySmiley/PoorDown#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "gioco",
    "gioco da tavolo",
    "multiplayer",
    "game",
    "board game"
  ],
  "main": "./dist/estensione.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "poordown.avvia",
        "title": "Avvia il gioco",
        "category": "PoorDown",
        "icon": "$(play)"
      },
      {
        "command": "poordown.avviaInCasa",
        "title": "Avvia il gioco solo per la rete di casa",
        "category": "PoorDown"
      },
      {
        "command": "poordown.entra",
        "title": "Entra in una partita con un link",
        "category": "PoorDown"
      },
      {
        "command": "poordown.copiaIndirizzo",
        "title": "Copia l'indirizzo per gli amici",
        "category": "PoorDown"
      },
      {
        "command": "poordown.apriPannelloDiControllo",
        "title": "Apri il pannello di controllo",
        "category": "PoorDown"
      },
      {
        "command": "poordown.impostaPannelloDiControllo",
        "title": "Imposta l'accesso al pannello di controllo",
        "category": "PoorDown"
      },
      {
        "command": "poordown.mostraMessaggi",
        "title": "Mostra i messaggi del server",
        "category": "PoorDown"
      },
      {
        "command": "poordown.spegni",
        "title": "Spegni il gioco",
        "category": "PoorDown"
      },
      {
        "command": "poordown.menu",
        "title": "Azioni",
        "category": "PoorDown"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "poordown.menu",
          "when": "false"
        },
        {
          "command": "poordown.copiaIndirizzo",
          "when": "poordown.acceso"
        },
        {
          "command": "poordown.apriPannelloDiControllo",
          "when": "poordown.acceso"
        },
        {
          "command": "poordown.spegni",
          "when": "poordown.nostro"
        }
      ]
    },
    "configuration": {
      "title": "PoorDown",
      "properties": {
        "poordown.porta": {
          "type": "integer",
          "default": 3000,
          "minimum": 1,
          "maximum": 65535,
          "scope": "machine",
          "markdownDescription": "La porta del gioco su questo PC. Cambiala solo se la 3000 è già usata da un altro programma: gli amici in casa useranno l'indirizzo con la porta nuova."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/compila.mjs",
    "pacchetto": "node scripts/compila.mjs && npx --yes @vscode/vsce@4.1.0 package --no-dependencies --out poordown.vsix",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/vscode": "1.101.0",
    "esbuild": "^0.28.2"
  }
}
